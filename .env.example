# Copy this file to .env for local use. Never commit a real secret key.
#
# run_server.py loads .env when it is present. Values already supplied by the
# operating system take precedence.

# Safe local-only defaults. Use 0.0.0.0 only when another device must connect.
MEAD_TRACKER_HOST=127.0.0.1
MEAD_TRACKER_PORT=8000

# Django application settings
MEAD_TRACKER_DEBUG=true
# Keep production keys single-quoted so characters such as $ stay literal.
MEAD_TRACKER_SECRET_KEY='replace-with-a-long-random-value'
MEAD_TRACKER_ALLOWED_HOSTS=localhost,127.0.0.1
MEAD_TRACKER_CSRF_TRUSTED_ORIGINS=
MEAD_TRACKER_ALLOW_SIGNUPS=true
MEAD_TRACKER_TIME_ZONE=America/Chicago

# A relative path is resolved from the project directory. In production, use
# an absolute path on persistent, backed-up storage.
MEAD_TRACKER_DB_PATH=data/mead_tracker.sqlite3
MEAD_TRACKER_BACKUP_DIR=backups
# Uploaded observation photos. Back up this directory with the database.
MEAD_TRACKER_MEDIA_ROOT=media

# The stable address encoded in QR labels. Do not use localhost if a phone
# needs to scan the label. Do not add a trailing slash.
MEAD_TRACKER_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Set true only when the browser always reaches the site over HTTPS.
MEAD_TRACKER_SECURE_COOKIES=false
# Set true only behind a trusted HTTPS reverse proxy that overwrites
# X-Forwarded-Proto and X-Forwarded-Host.
MEAD_TRACKER_TRUST_PROXY_HEADERS=false
# Exact address of the reverse proxy as seen by Waitress.
MEAD_TRACKER_TRUSTED_PROXY=127.0.0.1

# ChatGPT plugin / read-only MCP service. Keep this false until the web app and
# /mcp endpoint are exposed through the same trusted public HTTPS reverse proxy.
MEAD_TRACKER_CHATGPT_ENABLED=false
# The MCP process must remain loopback-only; the reverse proxy publishes it.
MEAD_TRACKER_MCP_HOST=127.0.0.1
MEAD_TRACKER_MCP_PORT=8766
# Public values used for OAuth discovery, resource binding, and ChatGPT account
# linking. Leave the callback empty for the discovery-only first launch, then
# paste the exact value shown by ChatGPT when adding the plugin. Do not enable
# the integration with HTTP or placeholder values.
MEAD_TRACKER_MCP_PUBLIC_URL=https://mead.example.com/mcp
MEAD_TRACKER_OAUTH_ISSUER_URL=https://mead.example.com/o
MEAD_TRACKER_CHATGPT_CLIENT_ID=mead-tracker-chatgpt
MEAD_TRACKER_CHATGPT_CALLBACK_URL=
