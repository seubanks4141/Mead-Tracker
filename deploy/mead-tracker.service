[Unit]
Description=Mead Tracker web application
After=network.target

[Service]
Type=simple
User=meadtracker
Group=meadtracker
WorkingDirectory=/opt/mead-tracker
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/mead-tracker/mead-tracker.env
StateDirectory=mead-tracker
UMask=0027

ExecStartPre=/opt/mead-tracker/.venv/bin/python /opt/mead-tracker/manage.py migrate --noinput
ExecStartPre=/opt/mead-tracker/.venv/bin/python /opt/mead-tracker/manage.py collectstatic --noinput
ExecStart=/opt/mead-tracker/.venv/bin/python /opt/mead-tracker/run_server.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
