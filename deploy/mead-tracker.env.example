# Install as /etc/mead-tracker/mead-tracker.env, owned by
# root:meadtracker and mode 0640.
# systemd EnvironmentFile syntax is KEY=VALUE (no "export").

# Change the port to any unused TCP port on the VM.
MEAD_TRACKER_HOST=127.0.0.1
MEAD_TRACKER_PORT=8765

MEAD_TRACKER_DEBUG=false
# Keep the generated key inside single quotes so shell metacharacters stay
# literal when an administrator runs a management command.
MEAD_TRACKER_SECRET_KEY='replace-with-output-of-django-secret-key-generator'
MEAD_TRACKER_ALLOWED_HOSTS=mead.example.com
MEAD_TRACKER_CSRF_TRUSTED_ORIGINS=https://mead.example.com
# Change to true only when visitors should be able to register themselves.
MEAD_TRACKER_ALLOW_SIGNUPS=false
MEAD_TRACKER_TIME_ZONE=America/Chicago
MEAD_TRACKER_SECURE_COOKIES=true
# The HTTPS reverse proxy must overwrite, not append, forwarded headers.
MEAD_TRACKER_TRUST_PROXY_HEADERS=true
MEAD_TRACKER_TRUSTED_PROXY=127.0.0.1

# StateDirectory=mead-tracker in the service creates this directory.
MEAD_TRACKER_DB_PATH=/var/lib/mead-tracker/mead-tracker.sqlite3
MEAD_TRACKER_BACKUP_DIR=/var/lib/mead-tracker/backups

# This exact origin is used to build the stable links encoded on labels.
MEAD_TRACKER_PUBLIC_BASE_URL=https://mead.example.com
